# Clerk authentication (dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk webhook signing secret (dashboard.clerk.com -> Webhooks), verifies /api/webhooks/clerk
CLERK_WEBHOOK_SECRET="whsec_..."

# OpenAI key for meal/label parsing (NUTRIMIND_ prefix avoids collision with system-level OPENAI_API_KEY)
NUTRIMIND_OPENAI_API_KEY="sk-proj-..."

# Database: local SQLite file or Turso libSQL URL
DATABASE_URL="file:./prisma/dev.db"

# Turso auth token (only needed when DATABASE_URL points at a remote libsql:// database)
TURSO_AUTH_TOKEN=""

# Set to "1" only in the hosted Sites runtime. Hosted deployments require a remote
# libsql:// or https:// DATABASE_URL and the Turso token above; file: SQLite stays local-only.
NUTRIMIND_HOSTED_RUNTIME="0"

# Shared secret for cron routes (/api/cron/*), sent as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="generate-a-long-random-string"
