# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/e2e/screenshots/

# next.js
/.next/
/.next-desktop/
/out/

# production
/build/*
!/build/sites-vite-plugin.ts
/dist/
/artifacts/

# Sites / Cloudflare local state
/.wrangler/
.dev.vars
.dev.vars.*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.codex-dev-server*.log

# generated reports
/graphify-out/
/.graphify_python
/.graphify_python/

# local database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# generated Prisma client
/src/generated/prisma/

# Android build state
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties

apply-turso-schema.mjs
verify-turso.mjs
turso-schema.sql

.quality-gate/
