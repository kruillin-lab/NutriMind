[Desktop Entry]
Version=1.0
Type=Application
Name=NutriMind
GenericName=Nutrition Tracker
Comment=Your private nutrition reserve
Exec=@APP_DIR@/scripts/nutrimind-desktop launch
Icon=@APP_DIR@/packaging/nutrimind.png
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=NutriMind
Actions=Stop;

[Desktop Action Stop]
Name=Stop NutriMind
Exec=@APP_DIR@/scripts/nutrimind-desktop stop
