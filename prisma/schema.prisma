generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "workerd"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Profile & Goals
  profile           UserProfile?
  metabolicProfile  MetabolicProfile?
  calorieBank       CalorieBank?

  // Daily tracking
  dailyLogs         DailyLog[]
  weightEntries     WeightEntry[]
  mealTemplates     MealTemplate[]
  bodyMeasurements  BodyMeasurement[]
  mealPlans         MealPlan[]
  progressPhotos    ProgressPhoto[]
  pushSubscriptions PushSubscription[]
  recipes           Recipe[]
  achievements      Achievement[]

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Physical stats
  heightCm        Float?
  birthDate       DateTime?
  gender          Gender?

  // Goals
  goalWeightKg    Float?
  targetDate      DateTime?
  activityLevel   ActivityLevel @default(SEDENTARY)

  // Preferences
  timezone        String   @default("America/New_York")
  emailDigest     Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

model MetabolicProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Learned values (not estimates)
  trueMetabolicRate   Float    // Actual calories burned per day
  bmrEstimate         Float    // Baseline BMR for comparison
  adaptiveFactor      Float    @default(0) // Metabolic adaptation %
  weightChangeFactor  Float    @default(3500) // Calories per pound (learned)

  // Prediction accuracy tracking
  predictionAccuracy  Float    @default(0) // 0-1, how accurate predictions are
  predictionsMade     Int      @default(0)
  predictionsCorrect  Int      @default(0)

  // Last calculation
  lastCalculatedAt    DateTime @default(now())
  calculationMethod   String   @default("harris_benedict") // How we started

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("metabolic_profiles")
}

model CalorieBank {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current state
  currentBalance  Float    @default(0)  // Available to spend
  totalBanked     Float    @default(0)  // Lifetime earned
  totalSpent      Float    @default(0)  // Lifetime spent

  // Daily tracking
  dailyTarget     Float    @default(2000) // Current target (learned)
  weeklyAverage   Float    @default(0)    // Avg consumed last 7 days

  // Smart features
  recommendedSpend    Float?   // AI recommendation
  spendByDate         DateTime? // Suggested deadline

  // Settings
  allowNegative     Boolean  @default(false) // Can go into debt?
  expireAfterDays   Int      @default(30)    // Banked calories expire?
  expiredAmount     Float    @default(0)     // Total calories already expired
  autoAdjustTarget  Boolean  @default(false) // Weekly cron recomputes dailyTarget from observed metabolism

  // Macro targets (grams per day)
  proteinTargetG    Float    @default(0)     // 0 = not set
  carbsTargetG      Float    @default(0)
  fatTargetG        Float    @default(0)

  // Relationships
  transactions    BankTransaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("calorie_banks")
}

model BankTransaction {
  id          String   @id @default(cuid())
  bankId      String
  bank        CalorieBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Float
  reason      String   // Human-readable explanation

  // Context
  caloriesConsumed  Float?   // What they actually ate
  caloriesTarget    Float?   // What they should have eaten
  weightAtTime      Float?   // Current weight when transaction happened

  // AI context
  llmAdvice         String?  // What the AI recommended
  userFollowed      Boolean? // Did they follow the advice?

  // Metadata
  sourceId    String?  // ID of meal log, etc.
  sourceType  String?  // "daily_log", "manual", "adjustment"
  expired     Boolean  @default(false) // Has this been expired?

  createdAt   DateTime @default(now())

  @@map("bank_transactions")
}

model DailyLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime

  // Nutrition
  caloriesConsumed  Float    @default(0)
  proteinG          Float    @default(0)
  carbsG            Float    @default(0)
  fatG              Float    @default(0)
  fiberG            Float    @default(0)
  sugarG            Float    @default(0)
  sodiumMg          Float    @default(0)
  vitaminCMg        Float    @default(0)
  calciumMg         Float    @default(0)
  ironMg            Float    @default(0)
  potassiumMg       Float    @default(0)

  // Targets for this day
  calorieTarget     Float    @default(2000)

  // Exercise
  caloriesBurned    Float    @default(0)
  exerciseMinutes   Int      @default(0)

  // Bank result
  bankedAmount      Float    @default(0)   // Positive = banked, negative = spent

  // Water tracking (in milliliters)
  waterMl           Float    @default(0)

  // Daily notes
  notes             String?  // Free text journal entry

  // Meals
  meals     Meal[]

  @@unique([userId, date])
  @@map("daily_logs")
}

model Meal {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  name        String
  mealType    MealType @default(OTHER) // breakfast, lunch, dinner, snack

  // Nutrition
  calories    Float
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)
  sugarG      Float    @default(0)
  sodiumMg    Float    @default(0)
  vitaminCMg  Float    @default(0)
  calciumMg   Float    @default(0)
  ironMg      Float    @default(0)
  potassiumMg Float    @default(0)

  // Serving size
  servingSizeG Float?   // Serving size in grams

  // Source
  source      String   @default("manual") // manual, photo, voice, recipe, barcode
  aiConfidence Float?  // If AI parsed it

  createdAt   DateTime @default(now())

  @@map("meals")
}

model WeightEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightKg    Float
  date        DateTime

  // Context
  source      String   @default("manual") // manual, smart_scale, import

  @@unique([userId, date])
  @@map("weight_entries")
}

model BodyMeasurement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime

  // Body measurements (in cm)
  waistCm     Float?
  hipsCm      Float?
  chestCm     Float?
  thighCm     Float?
  bicepCm     Float?
  shoulderCm  Float?
  neckCm      Float?

  // Body composition
  bodyFatPct  Float?   // Body fat percentage
  muscleMassKg Float?  // Muscle mass in kg

  // Context
  source      String   @default("manual") // manual, smart_scale, tape, import

  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@map("body_measurements")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY      // Little/no exercise
  LIGHT          // 1-3 days/week
  MODERATE       // 3-5 days/week
  ACTIVE         // 6-7 days/week
  VERY_ACTIVE    // 2x per day, physical job
}

enum TransactionType {
  BANK      // Underspent, added to bank
  SPEND     // Overspent, removed from bank
  ADJUST    // Manual adjustment
  EXPIRE    // Banked calories expired
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

model CachedFood {
  id            String   @id @default(cuid())
  normalizedKey String   @unique // lowercase, trimmed, spaces normalized
  originalText  String   // What user typed (for reference)

  // Nutrition data (from AI)
  name          String
  calories      Float
  proteinG      Float    @default(0)
  carbsG        Float    @default(0)
  fatG          Float    @default(0)
  fiberG        Float    @default(0)
  sugarG        Float    @default(0)
  sodiumMg      Float    @default(0)
  vitaminCMg    Float    @default(0)
  calciumMg     Float    @default(0)
  ironMg        Float    @default(0)
  potassiumMg   Float    @default(0)

  // Serving size
  servingSizeG  Float?

  // AI metadata
  aiConfidence  Float
  source        String   @default("openai") // openai, manual, usda, etc.

  // Cache statistics
  hitCount      Int      @default(1)
  lastUsedAt    DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([hitCount])
  @@index([lastUsedAt])
  @@map("cached_foods")
}

model MealTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  mealType    MealType @default(OTHER)

  // Nutrition
  calories    Float
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)
  sugarG      Float    @default(0)
  sodiumMg    Float    @default(0)
  vitaminCMg  Float    @default(0)
  calciumMg   Float    @default(0)
  ironMg      Float    @default(0)
  potassiumMg Float    @default(0)

  // Serving size
  servingSizeG Float?

  // Usage tracking
  useCount    Int      @default(0)
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([useCount])
  @@map("meal_templates")
}

model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String   // e.g., "Week of Jan 15", "Cutting Phase"
  description String?

  startDate   DateTime // Plan start date
  endDate     DateTime // Plan end date

  // Status
  isActive    Boolean  @default(true)
  isTemplate  Boolean  @default(false) // Can be reused

  // Relations
  items       MealPlanItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([isTemplate])
  @@map("meal_plans")
}

model MealPlanItem {
  id          String   @id @default(cuid())
  mealPlanId  String
  mealPlan    MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  // When this meal is planned for
  plannedDate DateTime
  mealType    MealType @default(OTHER)

  // Meal details
  name        String
  description String?

  // Nutrition (can be from template or custom)
  calories    Float
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)
  sugarG      Float    @default(0)
  sodiumMg    Float    @default(0)

  // Source tracking
  mealTemplateId String? // If created from a template

  // Status
  isLogged    Boolean  @default(false) // Has this been logged as an actual meal?
  loggedMealId String? // Reference to the actual Meal if logged

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mealPlanId])
  @@index([plannedDate])
  @@index([mealType])
  @@map("meal_plan_items")
}

model ProgressPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Photo data (base64 encoded)
  imageData   String   // Base64 encoded image data
  mimeType    String   // e.g., "image/jpeg", "image/png"

  // Photo metadata
  photoDate   DateTime @default(now())
  caption     String?  // Optional caption/description

  // Body measurements at time of photo (optional)
  weightKg    Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([photoDate])
  @@map("progress_photos")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Push subscription data (from PushManager.subscribe())
  endpoint  String   @unique
  p256dh    String
  auth      String

  // Device/user agent info
  userAgent String?

  // Notification preferences
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

model Recipe {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  servings    Int      @default(1)

  // JSON array of {name, calories, proteinG, carbsG, fatG, fiberG, sugarG, sodiumMg}
  ingredients String   @default("[]")

  // Pre-computed totals (whole recipe, divide by servings for per-serving)
  calories    Float    @default(0)
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)
  sugarG      Float    @default(0)
  sodiumMg    Float    @default(0)

  useCount    Int      @default(0)
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("recipes")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String
  icon        String   @default("🏆")

  unlockedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
  @@map("achievements")
}
