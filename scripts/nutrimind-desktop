#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
APP_HOST="localhost"
APP_PORT="${NUTRIMIND_PORT:-3001}"
APP_URL="http://${APP_HOST}:${APP_PORT}"
HEALTH_URL="${APP_URL}/api/health"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/nutrimind"
PID_FILE="${STATE_DIR}/server.pid"
LOG_FILE="${STATE_DIR}/server.log"
CHROMIUM_PROFILE="${STATE_DIR}/chromium-profile"
NEXT_BIN="${APP_DIR}/node_modules/.bin/next"
PRISMA_BIN="${APP_DIR}/node_modules/.bin/prisma"
DESKTOP_DIST="${APP_DIR}/.next-desktop"

notify_error() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="NutriMind" --urgency=critical "NutriMind could not start" "$1"
  fi
  printf 'NutriMind: %s\n' "$1" >&2
}

is_healthy() {
  curl --noproxy '*' --silent --fail --max-time 2 "$HEALTH_URL" 2>/dev/null | grep -q '"status":"ok"'
}

find_browser() {
  local candidate path
  for candidate in chromium chromium-browser google-chrome google-chrome-stable brave-browser microsoft-edge; do
    if path="$(command -v "$candidate" 2>/dev/null)"; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

stop_server() {
  if [[ ! -f "$PID_FILE" ]]; then
    return 0
  fi

  local pid
  pid="$(<"$PID_FILE")"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
}

start_server() {
  mkdir -p "$STATE_DIR" "$CHROMIUM_PROFILE"

  if is_healthy; then
    return 0
  fi

  if [[ ! -x "$NEXT_BIN" ]]; then
    notify_error "NutriMind dependencies are missing. Run scripts/install-desktop-app.sh from the NutriMind folder."
    return 1
  fi

  stop_server

  (
    cd "$APP_DIR"
    if [[ -x "$PRISMA_BIN" ]]; then
      "$PRISMA_BIN" migrate deploy >>"$LOG_FILE" 2>&1 || true
    fi

    # Serve the prebuilt desktop bundle when present, otherwise fall back to the dev server.
    if [[ -f "${DESKTOP_DIST}/BUILD_ID" ]]; then
      setsid env NUTRIMIND_DESKTOP=1 "$NEXT_BIN" start --hostname "$APP_HOST" --port "$APP_PORT" >>"$LOG_FILE" 2>&1 &
    else
      setsid "$NEXT_BIN" dev --webpack --hostname "$APP_HOST" --port "$APP_PORT" >>"$LOG_FILE" 2>&1 &
    fi
    printf '%s\n' "$!" >"$PID_FILE"
  )

  for _ in {1..60}; do
    if is_healthy; then
      return 0
    fi
    sleep 0.5
  done

  notify_error "The local server did not become ready. See ${LOG_FILE}."
  return 1
}

launch_window() {
  mkdir -p "$CHROMIUM_PROFILE"

  local browser
  if ! browser="$(find_browser)"; then
    notify_error "No Chromium-based browser found. Install google-chrome or chromium to open the NutriMind window."
    return 1
  fi

  setsid --fork "$browser" \
    --app="$APP_URL" \
    --class=NutriMind \
    --name=NutriMind \
    --user-data-dir="$CHROMIUM_PROFILE" \
    --no-first-run \
    --disable-features=Translate \
    </dev/null >/dev/null 2>&1
}

case "${1:-launch}" in
  launch)
    start_server
    launch_window
    ;;
  stop)
    stop_server
    ;;
  status)
    if is_healthy; then
      printf 'NutriMind is running at %s\n' "$APP_URL"
    else
      printf 'NutriMind is stopped\n'
      exit 1
    fi
    ;;
  *)
    printf 'Usage: %s [launch|stop|status]\n' "$0" >&2
    exit 2
    ;;
esac
